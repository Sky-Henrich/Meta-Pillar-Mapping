void automation.metaPillarMapping(string leadId)
{
	// Meta Pillar Mapping
	// -------------------
	// For leads synced from the Meta lead form by LeadChain:
	//   - Sets Leads.Top_Category from Leads.Meta_Ad_Pillar (the answer to
	//     "Describa su negocio").
	//   - Sets Leads.Language to "Español" when Lead_Source is "Meta Ads"
	//     and Language is empty.
	//   - Ticks Leads.Cadence_Ready so the lead enters the cadence, the first
	//     time Top_Category gets filled for a Meta Ads lead.
	//
	// Why this is needed: Map Dependency Fields only filter picklist options
	// in the CRM UI. They never fill the child field, so leads created through
	// the API (LeadChain) arrive with Top_Category empty.
	//
	// Workflow setup (Settings > Automation > Workflow Rules > Leads):
	//   When:       Record action = Create or Edit
	//               + "Repeat this workflow whenever a Lead is edited"
	//               (or: Field update > Meta_Ad_Pillar)
	//   Condition:  Lead Source is Meta Ads  OR  Meta_Ad_Pillar is not empty
	//   Instant action: Function > this function
	//   Argument:   leadId = Leads - Lead Id
	//
	// Deluge has no sleep(). Re-read the record a few times instead, so a
	// value that LeadChain writes a moment after the create is still seen.
	// The Edit trigger above covers anything that arrives later than this.
	attempts = {1,2,3,4,5};
	pillar = "";
	currentTop = "";
	leadSource = "";
	currentLanguage = "";
	for each attempt in attempts
	{
		if(pillar == "")
		{
			lead = zoho.crm.getRecordById("Leads",leadId.toLong());
			pillar = ifnull(lead.get("Meta_Ad_Pillar"),"").trim();
			currentTop = ifnull(lead.get("Top_Category"),"");
			leadSource = ifnull(lead.get("Lead_Source"),"");
			currentLanguage = ifnull(lead.get("Language"),"");
		}
	}
	updateMap = Map();
	// Language: every Meta lead is Spanish-speaking. Only fill it when empty
	// so a value a salesperson set by hand is never overwritten.
	if(leadSource == "Meta Ads" && currentLanguage == "")
	{
		updateMap.put("Language","Español");
	}
	// Top_Category: match on the leading keyword ("Visita", "Experiencia", ...)
	// so small differences in accents, dashes or spacing from Meta don't break it.
	if(pillar != "")
	{
		key = pillar.toLowerCase();
		if(key.contains(" - "))
		{
			key = key.getPrefix(" - ").trim();
		}
		else if(key.contains("-"))
		{
			key = key.getPrefix("-").trim();
		}
		keyMap = Map();
		keyMap.put("visita","Visit");
		keyMap.put("experiencia","Experience");
		keyMap.put("reubicación","Relocate");
		keyMap.put("reubicacion","Relocate");
		keyMap.put("reside","Stay");
		keyMap.put("vive","Live");
		topCategory = keyMap.get(key);
		if(topCategory == null)
		{
			info "Lead " + leadId + ": no Top_Category mapping for '" + pillar + "'.";
		}
		else if(currentTop != topCategory)
		{
			updateMap.put("Top_Category",topCategory);
			// Cadence: only on the first mapping (Top_Category was empty), so
			// unticking Cadence Ready by hand later is not undone on the next edit.
			if(leadSource == "Meta Ads" && currentTop == "")
			{
				updateMap.put("Cadence_Ready",true);
			}
		}
	}
	else
	{
		info "Lead " + leadId + ": Meta_Ad_Pillar still empty, Top_Category not mapped.";
	}
	if(updateMap.isEmpty())
	{
		info "Lead " + leadId + ": nothing to update.";
		return;
	}
	// Fire workflows so rules that depend on these fields still run. This
	// does not loop: Meta_Ad_Pillar and Lead_Source are unchanged by this update.
	response = zoho.crm.updateRecord("Leads",leadId.toLong(),updateMap,{"trigger":{"workflow"}});
	info "Lead " + leadId + ": updated " + updateMap + " | " + response;
}
