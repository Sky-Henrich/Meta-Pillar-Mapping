/*
 * Meta Pillar Mapping
 * -------------------
 * Sets Leads.Top_Category from Leads.Meta_Ad_Pillar (the answer to
 * "Describa su negocio" pushed by LeadChain from the Meta lead form).
 *
 * Why this is needed: Map Dependency Fields only filter picklist options
 * in the CRM UI. They never fill the child field, so leads created through
 * the API (LeadChain) arrive with Top_Category empty.
 *
 * Workflow setup (Settings > Automation > Workflow Rules > Leads):
 *   When:       Record action = Create or Edit
 *               + "Repeat this workflow whenever a Lead is edited"
 *               (or: Field update > Meta_Ad_Pillar)
 *   Condition:  Meta_Ad_Pillar is not empty
 *   Instant action: Function > this function
 *   Argument:   leadId = Leads - Lead Id
 */
void automation.metaPillarMapping(string leadId)
{
	// Deluge has no sleep(). Re-read the record a few times instead, so a
	// value that LeadChain writes a moment after the create is still seen.
	// The Edit trigger above covers anything that arrives later than this.
	attempts = {1,2,3,4,5};
	pillar = "";
	currentTop = "";
	for each attempt in attempts
	{
		if(pillar == "")
		{
			lead = zoho.crm.getRecordById("Leads",leadId.toLong());
			pillar = ifnull(lead.get("Meta_Ad_Pillar"),"").trim();
			currentTop = ifnull(lead.get("Top_Category"),"");
		}
	}
	if(pillar == "")
	{
		info "Lead " + leadId + ": Meta_Ad_Pillar still empty, nothing to map.";
		return;
	}
	// Match on the leading keyword ("Visita", "Experiencia", ...) so small
	// differences in accents, dashes or spacing from Meta don't break it.
	key = pillar.toLowerCase();
	if(key.contains(" - "))
	{
		key = key.getPrefix(" - ").trim();
	}
	else if(key.contains("-"))
	{
		key = key.getPrefix("-").trim();
	}
	keyMap = Map();
	keyMap.put("visita","Visit");
	keyMap.put("experiencia","Experience");
	keyMap.put("reubicación","Relocate");
	keyMap.put("reubicacion","Relocate");
	keyMap.put("reside","Stay");
	keyMap.put("vive","Live");
	topCategory = keyMap.get(key);
	if(topCategory == null)
	{
		info "Lead " + leadId + ": no Top_Category mapping for '" + pillar + "'.";
		return;
	}
	if(currentTop == topCategory)
	{
		info "Lead " + leadId + ": Top_Category already '" + topCategory + "'.";
		return;
	}
	updateMap = Map();
	updateMap.put("Top_Category",topCategory);
	// Fire workflows so rules that depend on Top_Category still run. This
	// does not loop: Meta_Ad_Pillar is unchanged by this update.
	response = zoho.crm.updateRecord("Leads",leadId.toLong(),updateMap,{"trigger":{"workflow"}});
	info "Lead " + leadId + ": '" + pillar + "' -> '" + topCategory + "' | " + response;
}
